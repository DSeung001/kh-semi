<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzanmat.tour.member.mapper.MemberMapper">

    <insert id="save" parameterType="MemberDto">
        INSERT INTO
        `USER`
        (
         USER_ID
        ,USER_PASSWORD
        ,EMAIL
        ,NICKNAME
        ,USER_NAME
        ,BIO
        ,PROFILE
        )
        VALUES
        (
         #{userId}
        ,#{userPassword}
        ,#{email}
        ,#{nickname}
        ,#{userName}
        ,#{bio}
        ,#{profile}
        )
    </insert>

    <select id="countByMemberId" resultType="int">
        SELECT COUNT(*)
          FROM `USER`
         WHERE USER_ID = #{userId}
    </select>

    <select id="findByMemberId" resultType="MemberDto">
        SELECT id
              ,user_id
              ,user_password
              ,nickname
              ,email
              ,role
          FROM `USER`
         WHERE user_id = #{userId}
    </select>

    <update id="update" parameterType="MemberDto">
        UPDATE `USER`
        <set>
            <if test="nickname != null">
                nickname = #{nickname},
            </if>
            <if test="bio != null">
                bio = #{bio},
            </if>
            <if test="email != null">
                email = #{email},
            </if>
            <if test="userName != null">
                user_name = #{userName},
            </if>
            <if test="profile != null">
                profile = #{profile},
            </if>
        </set>
         WHERE USER_ID = #{userId}
    </update>

    <select id="findById" parameterType="String" resultType="MemberDto">
        SELECT user_id
              ,nickname
              ,bio
              ,user_name
              ,email
              ,profile
              ,login_type
              ,role
          FROM `USER`
         WHERE USER_ID = #{userId}
    </select>

    <select id="findByEmail" resultType="MemberDto">
        SELECT user_id
          FROM `USER`
         WHERE email = #{email}
    </select>

    <select id="findByUserIdAndEmail" resultType="MemberDto">
        SELECT user_id
          FROM `USER`
         WHERE user_id = #{userId}
           AND email = #{email}
    </select>

    <update id="updatePasswordByEmail">
        UPDATE `USER`
           SET user_password = #{userPassword}
         WHERE email = #{email}
    </update>

    <delete id="deleteByMemberId">
        DELETE FROM user
         WHERE user_id = #{userId}
    </delete>

</mapper>
