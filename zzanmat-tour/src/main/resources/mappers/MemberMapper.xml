<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
    namespace : 해당 XML파일을 어떤 Mapper 인터페이스와 연결할지를 정해주는 속성.
-->
<mapper namespace="com.zzanmat.tour.member.mapper.MemberMapper">

    <insert id="insertMember" parameterType="MemberDto">
        INSERT INTO `USER` (USER_ID, USER_PASSWORD, EMAIL, NICKNAME)
        VALUES (#{userId}, #{userPassword}, #{email}, #{nickname})
    </insert>

    <select id="countByMemberId" parameterType="string" resultType="int">
        SELECT COUNT(*)
          FROM `USER`
         WHERE USER_ID = #{userId}
    </select>

    <select id="selectByMemberId" parameterType="string" resultType="MemberDto">
        SELECT id
              ,user_id
              ,user_password
              ,nickname
              ,email
              <!--,DATE_FORMAT(create_at, '%Y-%M-%d %H:%i') as create_at_str-->
          FROM `USER`
         WHERE user_id = #{userId}
    </select>

</mapper>